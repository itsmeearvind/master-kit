
// RBAC uses same schema as Auth - already in auth package
// Just ensure Role and UserRole models exist (see @maasters/auth prisma)

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  createdAt   DateTime @default(now())
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  assignedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}
